[Unit]
Description=UniFi Protect Camera Toggle
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lherzog
WorkingDirectory=/opt/unifi-camera-toggle
ExecStart=/opt/unifi-camera-toggle/.venv/bin/python3 app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
