[Unit]
Description=UniFi Audit Log Viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lherzog
WorkingDirectory=/opt/unifi-audit-viewer
ExecStart=/opt/unifi-audit-viewer/.venv/bin/python3 app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
